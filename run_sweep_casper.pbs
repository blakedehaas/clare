#!/bin/bash
#PBS -N tempest_hpo_sweep
#PBS -A UCUL0008
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -l walltime=24:00:00
#PBS -q casper
#PBS -j oe
#PBS -m abe
#PBS -M blake.dehaas@lasp.colorado.edu

# ==============================================================================
# NCAR Casper Supercomputing PBS Batch Script:
# Distributed Space Physics Multi-Fidelity Bayesian HPO Sweep (Optuna + BOHB)
# ==============================================================================
# To run as a multi-GPU parallel worker array across 4 nodes:
#   qsub -J 1-4 run_sweep_casper.pbs
# All workers will dynamically coordinate via the shared GLADE journal log!
# ==============================================================================

# Navigate to the project directory from which the job was submitted
cd "$PBS_O_WORKDIR" || { echo "[ERROR] Failed to change directory to \$PBS_O_WORKDIR."; exit 1; }

echo "============================================================"
echo "[INFO] Job started at: $(date)"
echo "[INFO] Job running on host: $(hostname)"
echo "[INFO] Job ID: $PBS_JOBID"
echo "[INFO] Current working directory: $(pwd)"
echo "============================================================"
echo ""

# Load NCAR official modules
module --force purge
module load ncarenv/24.12
module load gcc
module load cuda/12.8.0
module load conda

# Activate project virtual environment
if [ -f "clare_venv/bin/activate" ]; then
    source clare_venv/bin/activate
elif [ -f "../clare_venv/bin/activate" ]; then
    source ../clare_venv/bin/activate
else
    echo "[WARNING] clare_venv/bin/activate not found directly. Checking conda / system python..."
fi

echo "[INFO] Python executable: $(which python)"
python -c "import torch; print(f'[INFO] PyTorch version: {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"
echo ""

# Display GPU hardware and driver status
echo "[INFO] GPU allocation details:"
echo "CUDA_VISIBLE_DEVICES = $CUDA_VISIBLE_DEVICES"
echo ""
nvidia-smi
echo ""

# Experiment tracking configuration
export WANDB_MODE=online
export WANDB_PROJECT=tempest_space_physics_hpo

# Shared Optuna Journal Storage on NCAR GLADE Scratch
# JournalFileBackend uses an append-only log without POSIX SQLite locks, avoiding Lustre file locking crashes.
SCRATCH_DIR="/glade/derecho/scratch/$USER/tempest_hpo"
mkdir -p "$SCRATCH_DIR"
OPTUNA_STORAGE="${SCRATCH_DIR}/optuna_journal.log"

echo "============================================================"
echo "[INFO] Launching Distributed Multi-Fidelity HPO Sweep (TEMPEST)"
echo "[INFO] Storage URI:     $OPTUNA_STORAGE"
echo "[INFO] Study Name:      tempest_space_physics_sweep"
echo "[INFO] Max Budget:      27 epochs / trial (Hyperband 3-rung)"
echo "[INFO] Target Trials:   150 trials / worker"
echo "============================================================"

python sweep.py \
    --n_trials 150 \
    --epochs_per_trial 27 \
    --pruner hyperband \
    --min_resource 3 \
    --reduction_factor 3 \
    --storm_weight 0.25 \
    --batch_size 512 \
    --storage "$OPTUNA_STORAGE" \
    --study_name "tempest_space_physics_sweep" \
    --data_dir "dataset/processed_dataset_01_31_storm" \
    --output_dir "checkpoints/sweep_results" \
    --seed 42

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "[ERROR] HPO Sweep failed with exit code: $EXIT_CODE"
    exit $EXIT_CODE
fi

echo ""
echo "============================================================"
echo "[INFO] HPO Sweep completed successfully at: $(date)"
echo "============================================================"
