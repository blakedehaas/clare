#!/bin/bash
#PBS -N validate_dataset_job
#PBS -A UCUL0008
#PBS -l select=1:ncpus=2:mem=16GB
#PBS -l walltime=04:00:00
#PBS -q casper
#PBS -j oe
#PBS -m abe
#PBS -M blake.dehaas@lasp.colorado.edu

# Load NCAR modules
module --force purge
module load ncarenv/24.12
module load gcc
module load conda

# Activate virtual environment
source /glade/campaign/univ/ucul0008/auroral_precipitation_ml/clare/clare_venv/bin/activate || {
    echo "[ERROR] Failed to activate clare_venv"
    exit 1
}

# Navigate to the directory from which the job was submitted
cd "$PBS_O_WORKDIR" || {
    echo "[ERROR] Failed to change directory to \$PBS_O_WORKDIR."
    exit 1
}

echo "[INFO] Job started at: $(date)"
echo "[INFO] Job running on host: $(hostname)"
echo "[INFO] Job ID: $PBS_JOBID"
echo "[INFO] Current working directory: $(pwd)"
echo "[INFO] Environment activated: $(which python)"
python --version
echo ""

# Run validation
python validate_dataset.py

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "[ERROR] Dataset validation failed with exit code: $EXIT_CODE"
    exit $EXIT_CODE
fi

echo ""
echo "[INFO] Dataset validation completed successfully at: $(date)"