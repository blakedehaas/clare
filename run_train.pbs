#!/bin/bash
#PBS -N train_clare_continuous
#PBS -A UCUL0008
#PBS -l select=1:ncpus=8:ngpus=1:mem=32GB
#PBS -l walltime=24:00:00
#PBS -q casper
#PBS -j oe
#PBS -m abe
#PBS -M blake.dehaas@lasp.colorado.edu

# Navigate to the directory from which the job was submitted
cd "$PBS_O_WORKDIR" || { echo "[ERROR] Failed to change directory to \$PBS_O_WORKDIR."; exit 1; }

echo "[INFO] Job started at: $(date)"
echo "[INFO] Job running on host: $(hostname)"
echo "[INFO] Job ID: $PBS_JOBID"
echo "[INFO] Current working directory: $(pwd)"
echo ""

# Load NCAR's modules (matching setup_env.sh)
module --force purge
module load ncarenv/24.12
module load gcc
module load cuda/12.8.0
module load conda

# Activate your venv environment
source clare_venv/bin/activate

echo "[INFO] Environment activated: $(which python)"
echo ""

export WANDB_MODE=online

# Display GPU hardware information
echo "[INFO] GPU(s) allocated by PBS:"
echo "CUDA_VISIBLE_DEVICES = $CUDA_VISIBLE_DEVICES"
echo ""
echo "nvidia-smi output:"
nvidia-smi
echo ""

# Hard-coded array of seeds for the block-split methodology
SEEDS=(0 1 2)

echo "[INFO] Starting continuous model training for seeds: ${SEEDS[*]}"

# Run the Python script for each seed sequentially
for SEED in "${SEEDS[@]}"; do
    echo "============================================================"
    echo "[INFO] Launching training for Seed $SEED (Continuous Variant)"
    echo "============================================================"
    
    python train.py --seed "$SEED" --continuous
    
    EXIT_CODE=$?
    if [ $EXIT_CODE -ne 0 ]; then
        echo "[ERROR] Python script failed for Seed $SEED with exit code: $EXIT_CODE"
        # Optional: exit 1 here if you want the whole job to stop on a single failure
    else
        echo "[SUCCESS] Training finished for Seed $SEED"
    fi
    echo ""
done

echo "[INFO] All continuous training loops finished at: $(date)"